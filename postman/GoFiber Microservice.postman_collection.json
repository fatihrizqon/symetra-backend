	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global guard: kalau 401, kemungkinan access_token sudah revoked/expired.",
					"if (pm.response.code === 401) {",
					"    console.warn('401 Unauthorized - access_token mungkin kosong/expired/revoked. Login ulang atau refresh token.');",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{base_url}}/auth/register"
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Simpan access_token & refresh_token otomatis ke collection variable",
									"// supaya bisa dipakai request lain via {{access_token}} tanpa input manual.",
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"",
									"    // sesuaikan path field ini dengan struktur response asli backend kamu",
									"    const accessToken = jsonData.access_token || jsonData.data?.access_token;",
									"    const refreshToken = jsonData.refresh_token || jsonData.data?.refresh_token;",
									"",
									"    if (accessToken) {",
									"        pm.collectionVariables.set('access_token', accessToken);",
									"        console.log('access_token tersimpan.');",
									"    } else {",
									"        console.warn('access_token tidak ditemukan di response Login.');",
									"    }",
									"",
									"    if (refreshToken) {",
									"        pm.collectionVariables.set('refresh_token', refreshToken);",
									"    }",
									"} else {",
									"    console.warn('Login gagal, status: ' + pm.response.code);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{base_url}}/auth/login"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Refresh token juga menghasilkan access_token baru -> update collection variable.",
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    const accessToken = jsonData.access_token || jsonData.data?.access_token;",
									"    const refreshToken = jsonData.refresh_token || jsonData.data?.refresh_token;",
									"",
									"    if (accessToken) {",
									"        pm.collectionVariables.set('access_token', accessToken);",
									"        console.log('access_token diperbarui via refresh.');",
									"    }",
									"    if (refreshToken) {",
									"        pm.collectionVariables.set('refresh_token', refreshToken);",
									"    }",
									"} else {",
									"    console.warn('Refresh token gagal, kemungkinan refresh_token sudah revoked/expired.');",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{base_url}}/auth/refresh"
					},
					"response": []
				},
				{
					"name": "Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Setelah logout, access_token dianggap revoked di server.",
									"// Hapus dari collection variable supaya request berikutnya otomatis unauthenticated.",
									"if (pm.response.code === 200) {",
									"    pm.collectionVariables.unset('access_token');",
									"    pm.collectionVariables.unset('refresh_token');",
									"    console.log('access_token & refresh_token dihapus (revoked).');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{base_url}}/auth/logout"
					},
					"response": []
				}
			]
		},
